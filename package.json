{
  "name": "antigravity-zh-cn",
  "version": "1.0.0",
  "description": "Google Antigravity 2.0 简体中文持久化汉化补丁（零外部依赖 + 双引擎防更新自愈架构，支持 macOS / Windows / Linux）",
  "type": "module",
  "bin": {
    "antigravity-zh-cn": "./bin/cli.mjs"
  },
  "scripts": {
    "start": "node ./bin/cli.mjs install",
    "install-patch": "node ./bin/cli.mjs install",
    "uninstall-patch": "node ./bin/cli.mjs uninstall"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leemating/antigravity-zh-cn.git"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "zh-cn",
    "chinese",
    "localization",
    "i18n",
    "汉化",
    "简体中文"
  ],
  "author": "Leemating",
  "license": "MIT",
  "files": [
    "bin/",
    "src/",
    "install.sh",
    "uninstall.sh",
    "install.ps1",
    "uninstall.ps1",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
